{
  "name": "vx-sticker-frame",
  "fps": 30,
  "duration": 2.4,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "antonio",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "title": {
      "type": "string",
      "max_length": 42,
      "default": "Capitolo Uno"
    },
    "kicker": {
      "type": "string",
      "max_length": 28,
      "default": "serie"
    },
    "tag": {
      "type": "string",
      "max_length": 24,
      "default": "SPAZIO 13"
    },
    "accent": {
      "type": "color",
      "values": ["#FFFFFF", "#FFD400", "#38E1FF", "#FF4D6D"],
      "default": "#FFFFFF"
    },
    "thickness": {
      "type": "number",
      "min": 8,
      "max": 48,
      "default": 26
    }
  }
}
