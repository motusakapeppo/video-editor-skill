{
  "name": "vx-progress-ring",
  "fps": 30,
  "duration": 2.0,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "value": { "type": "number", "min": 0, "max": 100, "default": 74 },
    "label": { "type": "string", "max_length": 44, "default": "Storage used" },
    "caption": { "type": "string", "max_length": 40, "default": "sync / 2.4 GB" },
    "accent": {
      "type": "color",
      "values": ["#38E1FF", "#FFD400", "#FF4D4D", "#7CFF6B", "#FFFFFF"],
      "default": "#38E1FF"
    }
  }
}
