{
  "name": "vx-counter-percent",
  "fps": 30,
  "duration": 1.9,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "antonio",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "value": { "type": "number", "min": 0, "max": 100, "default": 87 },
    "caption": { "type": "string", "max_length": 36, "default": "Conversion rate" },
    "note": { "type": "string", "max_length": 28, "default": "Aug 2026" },
    "accent": {
      "type": "color",
      "values": ["#7CFF6B", "#FFD400", "#FF4D4D", "#38E1FF", "#FFFFFF"],
      "default": "#7CFF6B"
    }
  }
}
