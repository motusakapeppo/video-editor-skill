{
  "name": "vx-subtitle-box",
  "fps": 30,
  "duration": 2.2,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "text": {
      "type": "string",
      "max_length": 90,
      "default": "Qui comincia il viaggio"
    },
    "accent": {
      "type": "color",
      "values": ["#FFD400", "#FF6B4A", "#38E1FF", "#B7FF4D", "#FFFFFF"],
      "default": "#FFD400"
    },
    "radius": {
      "type": "int",
      "min": 0,
      "max": 44,
      "default": 26
    },
    "casing": {
      "type": "string",
      "values": ["none", "upper"],
      "default": "none"
    }
  }
}
