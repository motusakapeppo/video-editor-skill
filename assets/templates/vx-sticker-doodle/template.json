{
  "name": "vx-sticker-doodle",
  "fps": 30,
  "duration": 2.2,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter"],
      "default": "antonio"
    },
    "label": {
      "type": "string",
      "max_length": 16,
      "default": "IDEA"
    },
    "caption": {
      "type": "string",
      "max_length": 32,
      "default": "sketch it"
    },
    "accent": {
      "type": "color",
      "values": ["#FF5C8A", "#FFD400", "#38E1FF", "#7CFF6B", "#FFFFFF"],
      "default": "#FF5C8A"
    },
    "stroke": {
      "type": "number",
      "min": 6,
      "max": 30,
      "default": 16
    },
    "wobble": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.34
    }
  }
}
