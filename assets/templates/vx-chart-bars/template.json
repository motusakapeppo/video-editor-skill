{
  "name": "vx-chart-bars",
  "fps": 30,
  "duration": 2.2,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "value": { "type": "number", "min": 0, "max": 100, "default": 78 },
    "caption": { "type": "string", "max_length": 32, "default": "Weekly output" },
    "labels": { "type": "string", "max_length": 64, "default": "Mon,Tue,Wed,Thu,Fri" },
    "accent": {
      "type": "color",
      "values": ["#FFD400", "#38E1FF", "#FF4D4D", "#7CFF6B", "#FFFFFF"],
      "default": "#FFD400"
    }
  }
}
