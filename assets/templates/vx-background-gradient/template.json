{
  "name": "vx-background-gradient",
  "fps": 30,
  "duration": 2.4,
  "size": [1080, 1920],
  "params": {
    "palette": {
      "type": "string",
      "values": ["aurora", "ember", "ocean", "mono"],
      "default": "aurora"
    },
    "intensity": {
      "type": "number",
