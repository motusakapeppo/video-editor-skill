{
  "name": "vx-transition-luma",
  "fps": 30,
  "duration": 2.0,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "fill": {
      "type": "color",
      "values": ["#141026", "#0E0E12", "#101A17", "#1A1010"],
      "default": "#141026"
    },
    "tint": {
      "type": "color",
      "values": ["#38E1FF", "#FFD400", "#FFFFFF", "#FF4D4D"],
      "default": "#38E1FF"
    },
    "feather": {
      "type": "number",
      "min": 0.02,
      "max": 0.45,
      "default": 0.16
    }
  }
}
