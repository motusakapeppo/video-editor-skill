{
  "name": "vx-background-grid",
  "fps": 30,
  "duration": 2.2,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "accent": {
      "type": "color",
      "values": ["#38E1FF", "#FF4D6D", "#FFD400", "#7CFF6B"],
      "default": "#38E1FF"
    },
    "gridSize": {
      "type": "number",
      "min": 24,
      "max": 200,
      "default": 54
    },
    "horizon": {
      "type": "number",
      "min": 0.3,
      "max": 0.7,
      "default": 0.54
    },
    "speed": {
      "type": "number",
      "min": 0,
      "max": 3,
      "default": 1.0
    }
  }
}
