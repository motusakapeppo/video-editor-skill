{
  "name": "vx-subtitle-bold",
  "fps": 30,
  "duration": 2.2,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter", "bebasneue", "montserrat", "playfairdisplay", "jetbrainsmono"],
      "default": "inter",
      "note": "Six bundled OFL-1.1 families: antonio (condensed display), inter (neutral text), bebasneue (poster), montserrat (geometric), playfairdisplay (editorial serif), jetbrainsmono (mono/tech)."
    },
    "text": {
      "type": "string",
      "max_length": 72,
      "default": "Adesso o mai piu"
    },
    "accent": {
      "type": "color",
      "values": ["#FF4D4D", "#FFD400", "#38E1FF", "#7CFF6B", "#FFFFFF"],
      "default": "#FF4D4D"
    },
    "align": {
      "type": "string",
      "values": ["left", "center"],
      "default": "left"
    },
    "tracking": {
      "type": "string",
      "values": ["tight", "tighter"],
      "default": "tight"
    }
  }
}
