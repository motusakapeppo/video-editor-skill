{
  "name": "vx-subtitle-karaoke",
  "fps": 30,
  "duration": 2.6,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter"],
      "default": "inter"
    },
    "text": {
      "type": "string",
      "max_length": 100,
      "default": "Nessuno nasce imparato si diventa"
    },
    "accent": {
      "type": "color",
      "values": ["#38E1FF", "#FFD400", "#FF4D4D", "#7CFF6B", "#FFFFFF"],
      "default": "#38E1FF"
    },
    "pace": {
      "type": "number",
      "min": 0.6,
      "max": 1.8,
      "default": 1.0
    },
    "casing": {
      "type": "string",
      "values": ["none", "upper"],
      "default": "none"
    }
  }
}
