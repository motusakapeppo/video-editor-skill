{
  "name": "vx-chart-line",
  "fps": 30,
  "duration": 2.4,
  "size": [1080, 1920],
  "params": {
    "font": {
      "type": "string",
      "values": ["antonio", "inter"],
      "default": "inter"
    },
    "value": { "type": "number", "min": 0, "max": 100, "default": 84 },
    "caption": { "type": "string", "max_length": 32, "default": "Reach" },
    "labels": { "type": "string", "max_length": 72, "default": "Jan,Feb,Mar,Apr,May,Jun" },
    "accent": {
      "type": "color",
      "values": ["#38E1FF", "#FFD400", "#FF4D4D", "#7CFF6B", "#FFFFFF"],
      "default": "#38E1FF"
    }
  }
}
